{
  "name": "@demonbloodx2/watchtower",
  "version": "0.1.0",
  "description": "Tells you when your app breaks. Writes every error, crash and refused request to the logs and sends it to a Telegram chat, with repeats counted instead of repeated. No dependencies. Works in Next and in any Node app.",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "files": ["dist"],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./next": {
      "types": "./dist/next.d.ts",
      "import": "./dist/next.js"
    },
    "./react": {
      "types": "./dist/react.d.ts",
      "import": "./dist/react.js"
    }
  },
  "scripts": {
    "build": "rm -rf dist && tsup",
    "check-types": "tsc --noEmit",
    "test": "npm run build && node --test test/*.test.mjs",
    "prepublishOnly": "npm run test"
  },
  "keywords": ["error-reporting", "telegram", "alerts", "nextjs", "monitoring", "error-tracking", "instrumentation", "onRequestError"],
  "peerDependencies": {
    "react": "^18.3.0 || ^19.0.0"
  },
  "peerDependenciesMeta": {
    "react": { "optional": true }
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "react": "^19.0.0",
    "tsup": "^8.3.0",
    "typescript": "^5.6.0"
  }
}
